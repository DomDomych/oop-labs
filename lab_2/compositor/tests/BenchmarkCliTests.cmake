file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/run.json" [=[{
  "canvas":{"width":16,"height":8,"background":[255,255,255]},
  "render":{"mode":"parallel-safe","threads":2,"region":{"width":4,"height":4}},
  "rectangles":[{"x":0,"y":0,"width":16,"height":8,"color":[1,2,3],"priority":0}],
  "output":{"image":"unused.ppm"}, "logging":{"file":"unused.jsonl"}
}]=])
set(plan "${TEST_DIR}/benchmark.json")
file(WRITE "${plan}" [=[{"input":"run.json","warmup":1,"repetitions":3,"report":"report.json"}]=])
execute_process(COMMAND "${PROGRAM}" "${plan}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Benchmark failed: ${error}")
endif()
file(READ "${TEST_DIR}/report.json" report)
string(JSON count LENGTH "${report}" candidate samples)
string(JSON correct GET "${report}" matches_reference)
if(NOT count EQUAL 3 OR NOT correct)
    message(FATAL_ERROR "Incomplete/incorrect benchmark report")
endif()
if(EXISTS "${TEST_DIR}/unused.ppm" OR EXISTS "${TEST_DIR}/unused.jsonl")
    message(FATAL_ERROR "Benchmark must not export images or initialize run-config logging")
endif()
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE status)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "Missing argument must return 2")
endif()
file(WRITE "${plan}" "{bad")
execute_process(COMMAND "${PROGRAM}" "${plan}" RESULT_VARIABLE status)
if(NOT status EQUAL 1)
    message(FATAL_ERROR "Bad config must return 1")
endif()
file(READ "${TEST_DIR}/report.json" after)
if(NOT after STREQUAL report)
    message(FATAL_ERROR "Bad input changed old report")
endif()
