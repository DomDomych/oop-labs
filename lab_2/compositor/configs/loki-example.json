{
  "canvas": {"width": 1280, "height": 720, "background": [255, 255, 255]},
  "render": {"mode": "parallel-safe", "threads": 4, "region": {"width": 32, "height": 32}},
  "rectangles": [
    {"x": 10, "y": 20, "width": 200, "height": 100, "color": [255, 0, 0], "priority": 5}
  ],
  "output": {"image": "loki-result.ppm"},
  "logging": {
    "console": true,
    "file": "run.jsonl",
    "capacity": 1024,
    "loki": {
      "url": "http://localhost:3100/loki/api/v1/push",
      "labels": {"app": "compositor", "environment": "local"},
      "timeout_ms": 2000
    }
  }
}
