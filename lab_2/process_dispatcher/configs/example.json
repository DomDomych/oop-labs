{
  "mode": "async",
  "max_processes": 2,
  "block_size": 65536,
  "report": "../output/report.json",
  "logging": {"console": true, "file": "../output/run.jsonl"},
  "jobs": [
    {"id": "slow", "executable": "@self", "arguments": ["--fixture", "--delay-ms", "600", "--stdout", "slow output\n", "--stderr", "slow diagnostic\n"]},
    {"id": "fast", "executable": "@self", "arguments": ["--fixture", "--delay-ms", "20", "--stdout", "fast output\n"]},
    {"id": "empty", "executable": "@self", "arguments": ["--fixture"]}
  ]
}
